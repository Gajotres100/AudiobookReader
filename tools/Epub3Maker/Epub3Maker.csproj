<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Makes an EPUB 3 with Media Overlays out of an ebook and its audiobook, on a PC.

    The alignment is the app's own — the same Core, the same aligner, the same map — only with a
    desktop processor behind it, so the whole book can be listened to instead of sampled, and with a
    larger model than a phone can afford.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>epub3maker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioBookReader.Core\AudioBookReader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
