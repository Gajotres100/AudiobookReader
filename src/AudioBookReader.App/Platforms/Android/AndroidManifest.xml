<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- Network is needed to fetch the speech model, and to reach an Audiobookshelf server the
	     user has pointed the app at. Nothing about a book is sent anywhere on its own: import,
	     alignment and reading are entirely local. -->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<!-- Playback survives the app being backgrounded, and alignment keeps running with the screen
	     off. Android 14 requires the type to be declared alongside the permission. -->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

	<!-- Both services show a notification: transport controls for playback, progress for
	     alignment. Required at runtime from Android 13. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<!-- Alignment runs long enough that the device would otherwise sleep through it. -->
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<!-- For photographing a page to locate it in an ebook already in the library. Not required:
	     a device with no camera can still use the gallery picker the same feature offers. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />

	<!-- Deliberately absent: MANAGE_EXTERNAL_STORAGE and READ_EXTERNAL_STORAGE. Books are chosen
	     through the system file picker and copied into app storage, so the app never needs access
	     to the user's whole filesystem — which Play restricts heavily and would demand a
	     justification for. -->

	<!-- Lets the reader's word-translate chooser actually see translator apps on the device.
	     Android 11+ hides other apps' intent filters unless the declaring app names them here —
	     without this, the chooser for a long-pressed word would show nothing to choose from even
	     with Google Translate installed. -->
	<queries>
		<intent>
			<action android:name="android.intent.action.PROCESS_TEXT" />
			<data android:mimeType="text/plain" />
		</intent>
	</queries>

	<application
		android:allowBackup="true"
		android:networkSecurityConfig="@xml/network_security_config"
		android:icon="@mipmap/appicon"
		android:roundIcon="@mipmap/appicon_round"
		android:supportsRtl="true"
		android:label="@string/app_name">

		<!-- Declares this as a media app to Android Auto. The existing MediaSession — title,
		     author, cover, chapter-stepping commands — is what the car actually draws; this is
		     only the permission slip that gets it considered at all. -->
		<meta-data
			android:name="com.google.android.gms.car.application"
			android:resource="@xml/automotive_app_desc" />

		<!-- Every service is declared by its own [Service] attribute rather than by hand here.
		     A hand-written element names a class that does not exist: the build gives each one a
		     generated Java name, so ".Playback.PlaybackService" resolved to nothing while the real
		     service ran under its generated name alongside it. Two declarations of the playback
		     service meant Android Auto listed the app twice, once as an entry that could not be
		     bound at all. The attributes carry the exported flag, the foreground service type and
		     the intent filters. -->

	</application>
</manifest>
