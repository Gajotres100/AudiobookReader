<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- Camera: page-photo locate (BookViewModel.LocatePageAsync) and MediaPicker.CapturePhotoAsync.
	     No photo-library usage description: PHPickerViewController mediates access itself and needs
	     none, same reasoning as the Android photo picker needing no storage permission. -->
	<key>NSCameraUsageDescription</key>
	<string>Za fotografiranje stranice knjige radi pronalaska pozicije u tekstu.</string>

	<!-- audio: lets playback continue and keeps AVAudioSession alive in the background (AVPlayer +
	     MPNowPlayingInfoCenter, iOS-1). processing: BGProcessingTask for continuing whole-book
	     alignment after the app is backgrounded (iOS-4) — best-effort, not a guarantee like the
	     Android foreground service. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>

	<!-- Must list every BGTaskScheduler identifier the app registers, or Register() in
	     BackgroundAlignmentScheduler.cs silently refuses it at runtime. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gajotres.audiobookreader.alignment</string>
	</array>
</dict>
</plist>
