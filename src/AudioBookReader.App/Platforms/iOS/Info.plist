<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- Camera: page-photo locate (BookViewModel.LocatePageAsync) and MediaPicker.CapturePhotoAsync.
	     No photo-library usage description: PHPickerViewController mediates access itself and needs
	     none, same reasoning as the Android photo picker needing no storage permission. -->
	<key>NSCameraUsageDescription</key>
	<string>To photograph a page of the book and find that place in its text.</string>

	<!-- Audiobookshelf servers are almost always on the user's own network, on a plain port with no
	     certificate — the same reasoning as Android's network_security_config.xml, which permits
	     cleartext for exactly this. Without it iOS refuses every http:// address outright. Typing
	     https:// still gets https, with its certificate checked as normal. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<!-- Reaching a server on the local network needs the user's permission from iOS 14 on, and
	     without this description iOS never asks — the connection just fails. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>To connect to your Audiobookshelf server on this network.</string>

	<!-- Lets iOS use the Croatian strings in hr.lproj (app name, permission prompts). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>hr</string>
	</array>

	<!-- audio: lets playback continue and keeps AVAudioSession alive in the background (AVPlayer +
	     MPNowPlayingInfoCenter, iOS-1). processing: BGProcessingTask for continuing whole-book
	     alignment after the app is backgrounded (iOS-4) — best-effort, not a guarantee like the
	     Android foreground service. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>processing</string>
	</array>

	<!-- Must list every BGTaskScheduler identifier the app registers, or Register() in
	     BackgroundAlignmentScheduler.cs silently refuses it at runtime. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gajotres.audiobookreader.alignment</string>
	</array>
</dict>
</plist>
