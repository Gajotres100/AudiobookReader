<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        The pieces the app is assembled from.

        Colours live in Colors.xaml and the plain look of every control in Styles.xaml; what is here
        are the few named things a page reaches for by name. Kept small on purpose — a component set
        that grows past a screenful stops being a set and becomes a search.
    -->

    <!--  ======== Buttons ========  -->

    <!--
        A glyph in a bar. Everything in a toolbar is one of these, at one size, so a row of them
        reads as a row rather than as things that happen to be next to each other.
    -->
    <Style x:Key="Icon" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <!--  The same button where the label is a word rather than a glyph, so it needs room.  -->
    <Style
        x:Key="IconWide"
        BasedOn="{StaticResource Icon}"
        TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="WidthRequest" Value="-1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!--
        The one filled control on a screen, and there should never be two.

        Brass rather than a technology blue: it is the colour of a reading lamp, and the same amber
        the reader paints under the sentence being spoken — so the thing that starts the voice and
        the thing that marks it are visibly the same idea.
    -->
    <Style x:Key="Primary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccent}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20,14" />
    </Style>

    <!--  A real button that is not the primary one: outlined, so it still reads as pressable.  -->
    <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20,13" />
    </Style>

    <!--  Destructive, and the only place a red is allowed.  -->
    <Style x:Key="Destructive" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Alarm}, Dark={StaticResource AlarmDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Alarm}, Dark={StaticResource AlarmDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20,13" />
    </Style>

    <!--  ======== Transport ========  -->

    <!--
        Play on the player screen, where it is the one thing the screen is for.
    -->
    <Style x:Key="Play" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccent}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="CornerRadius" Value="38" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HeightRequest" Value="76" />
        <Setter Property="WidthRequest" Value="76" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--
        The same control in a bar, where the text is the screen and every pixel of chrome is a line
        of the book not being read. Flat, but in brass, so it is still the thing you reach for.
    -->
    <Style
        x:Key="PlayInline"
        BasedOn="{StaticResource Icon}"
        TargetType="Button">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!--  Skip back and forward: flat, but wide enough for "↺10".  -->
    <Style
        x:Key="Skip"
        BasedOn="{StaticResource Icon}"
        TargetType="Button">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="WidthRequest" Value="62" />
    </Style>

    <!--  ======== Surfaces ========  -->

    <!--
        A card: raised by a hairline and a fill, never by a shadow.
    -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!--  A book cover, or the space one will occupy while it loads.  -->
    <Style x:Key="Cover" TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Placeholder}, Dark={StaticResource PlaceholderDark}}" />
    </Style>

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
        <Setter Property="HeightRequest" Value="1" />
    </Style>

</ResourceDictionary>
