<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    Title="{x:Static s:Strings.Settings_Title}">

    <!--
        Settings, in cards.

        One card per question, with the question as its heading, rather than a single scroll of
        switches separated by rules. A page of settings is easiest to read when the eye can tell
        where one decision ends and the next begins without reading either.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" Spacing="14">

            <Label
                Margin="4,4,0,0"
                Style="{StaticResource Display}"
                Text="{x:Static s:Strings.Settings_Title}" />

            <!--  ======== How hard it may work the phone ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource Section}"
                            Text="{x:Static s:Strings.Settings_LoadSection}"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="1"
                            Clicked="OnAlignmentHelp"
                            Style="{StaticResource Icon}"
                            Text="?" />
                    </Grid>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_LoadBody}" />

                    <CollectionView
                        x:Name="BudgetList"
                        ItemsSource="{Binding Budgets}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BudgetOption">
                                <Grid
                                    Padding="0,10"
                                    ColumnDefinitions="26,*"
                                    ColumnSpacing="6">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBudgetTapped" />
                                    </Grid.GestureRecognizers>

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        IsVisible="{Binding IsSelected}"
                                        Text="✓"
                                        TextColor="{AppThemeBinding Light={StaticResource Accent},
                                                                    Dark={StaticResource AccentDark}}"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!--  ======== When it may work at all ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_WhenSection}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_OnlyCharging}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ChargingOnly}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_OnlyScreenOff}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ScreenOffOnly}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding MinimumBatteryText}" />
                        <Slider
                            Maximum="90"
                            Minimum="0"
                            Value="{Binding MinimumBatteryPercent}" />
                    </VerticalStackLayout>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_AlignmentNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  ======== How accurately it listens ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_RecognitionSection}" />

                    <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Settings_RecognitionBody}" />

                    <CollectionView
                        x:Name="RecognitionList"
                        ItemsSource="{Binding Recognitions}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecognitionOption">
                                <Grid
                                    Padding="0,10"
                                    ColumnDefinitions="26,*"
                                    ColumnSpacing="6">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecognitionTapped" />
                                    </Grid.GestureRecognizers>

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        IsVisible="{Binding IsSelected}"
                                        Text="✓"
                                        TextColor="{AppThemeBinding Light={StaticResource Accent},
                                                                    Dark={StaticResource AccentDark}}"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_WordTimes}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding WordTimestamps}" />
                    </Grid>

                    <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Settings_WordTimesNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  ======== Language ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_LanguageSection}" />

                    <Picker
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_LanguageNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  ======== Diagnostics ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_DiagnosticsSection}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_VerboseLog}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding VerboseLog}" />
                    </Grid>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_VerboseNote}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
