<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    Title="{x:Static s:Strings.Settings_Title}">

    <!--
        Settings, in cards.

        One card per question, with the question as its heading, rather than a single scroll of
        switches separated by rules. A page of settings is easiest to read when the eye can tell
        where one decision ends and the next begins without reading either.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" Spacing="14">

            <Label
                Margin="4,4,0,0"
                Style="{StaticResource Display}"
                Text="{x:Static s:Strings.Settings_Title}" />

            <!--  ======== How hard it may work the phone ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource Section}"
                            Text="{x:Static s:Strings.Settings_LoadSection}"
                            VerticalOptions="Center" />

                        <Button
                            Grid.Column="1"
                            Clicked="OnAlignmentHelp"
                            Style="{StaticResource Icon}"
                            Text="?" />
                    </Grid>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_LoadBody}" />

                    <CollectionView
                        x:Name="BudgetList"
                        ItemsSource="{Binding Budgets}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BudgetOption">
                                <Grid
                                    Padding="0,10"
                                    ColumnDefinitions="26,*"
                                    ColumnSpacing="6">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBudgetTapped" />
                                    </Grid.GestureRecognizers>

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        IsVisible="{Binding IsSelected}"
                                        Text="✓"
                                        TextColor="{AppThemeBinding Light={StaticResource Accent},
                                                                    Dark={StaticResource AccentDark}}"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!--
                ======== How closely it samples, when aligning ahead of time ========

                Right below the load preset, since both answer the same question: how hard this
                may work the phone. Kept apart from settings that answer a different one, such as
                when it may run or where the app opens.

                Read-along while reading has its own fixed spacing and is untouched by this: it
                measures the paragraph under the eye, not the whole book, and the two settings
                answer different questions.
            -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_SpacingSection}" />

                    <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Settings_SpacingBody}" />

                    <CollectionView
                        x:Name="ProbeSpacingList"
                        ItemsSource="{Binding ProbeSpacings}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProbeSpacingOption">
                                <Grid
                                    Padding="0,10"
                                    ColumnDefinitions="26,*"
                                    ColumnSpacing="6">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProbeSpacingTapped" />
                                    </Grid.GestureRecognizers>

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        IsVisible="{Binding IsSelected}"
                                        Text="✓"
                                        TextColor="{AppThemeBinding Light={StaticResource Accent},
                                                                    Dark={StaticResource AccentDark}}"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!--  ======== When it may work at all ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_WhenSection}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_OnlyCharging}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ChargingOnly}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_OnlyScreenOff}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ScreenOffOnly}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding MinimumBatteryText}" />
                        <Slider
                            Maximum="90"
                            Minimum="0"
                            Value="{Binding MinimumBatteryPercent}" />
                    </VerticalStackLayout>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_AlignmentNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  ======== Where the app opens ========  -->

            <Border IsVisible="{Binding HasServer}" Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_StartSection}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_OpenServerOnStart}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding OpenServerOnStart}" />
                    </Grid>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_OpenServerOnStartNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  ======== How accurately it listens ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_RecognitionSection}" />

                    <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Settings_RecognitionBody}" />

                    <CollectionView
                        x:Name="RecognitionList"
                        ItemsSource="{Binding Recognitions}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecognitionOption">
                                <Grid
                                    Padding="0,10"
                                    ColumnDefinitions="26,*"
                                    ColumnSpacing="6">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRecognitionTapped" />
                                    </Grid.GestureRecognizers>

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        IsVisible="{Binding IsSelected}"
                                        Text="✓"
                                        TextColor="{AppThemeBinding Light={StaticResource Accent},
                                                                    Dark={StaticResource AccentDark}}"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                        <Label Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_WordTimes}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding WordTimestamps}" />
                    </Grid>

                    <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Settings_WordTimesNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  ======== Language ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_LanguageSection}" />

                    <Picker
                        ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_LanguageNote}" />
                </VerticalStackLayout>
            </Border>

            <!--  ======== Diagnostics ========  -->


            <!--
                Where a report comes from. Deliberately the issue tracker rather than an email
                address: a report in an inbox is a conversation with one person that nobody else
                can find, search or add to.

                Deliberately no donation link, here or anywhere in the app. Google Play's payment
                rules reserve external payment links for tax-exempt charities, and apps have been
                made to strip theirs out over exactly this. Support lives on the website.
            -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_HelpSection}" />

                    <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Settings_HelpBody}" />

                    <Button
                        Command="{Binding ReportProblemCommand}"
                        Style="{StaticResource Secondary}"
                        Text="{x:Static s:Strings.Settings_ReportProblem}" />

                    <Button
                        Command="{Binding SuggestIdeaCommand}"
                        Style="{StaticResource Secondary}"
                        Text="{x:Static s:Strings.Settings_SuggestIdea}" />

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Muted}"
                        Text="{Binding VersionText}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Settings_DiagnosticsSection}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Settings_VerboseLog}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding VerboseLog}" />
                    </Grid>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Settings_VerboseNote}" />

                    <!--
                        The log is in the app's private storage, where nothing outside the app can
                        read it — on iOS not even with a cable. Handing it to the share sheet is the
                        one way to get it off a phone that shows a problem.
                    -->
                    <Button
                        Command="{Binding ShareLogCommand}"
                        Style="{StaticResource Secondary}"
                        Text="{x:Static s:Strings.Settings_ShareLog}" />

                    <!--  Alignments from other devices: shown a QR code to scan, or sent as a file.  -->
                    <BoxView Style="{StaticResource Divider}" />

                    <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Share_SettingsSection}" />

                    <Button
                        Command="{Binding ShowQrCommand}"
                        Style="{StaticResource Secondary}"
                        Text="{x:Static s:Strings.Share_ReceiveByQr}" />

                    <Button
                        Command="{Binding ImportAlignmentCommand}"
                        Style="{StaticResource Secondary}"
                        Text="{x:Static s:Strings.Share_ImportFile}" />

                    <!--  For typing in on a device that cannot find this one by itself.  -->
                    <Label Style="{StaticResource Muted}" Text="{Binding ShareAddressText}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
