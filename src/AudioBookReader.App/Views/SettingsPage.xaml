<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="False"
    Title="Postavke">

    <!--
        Settings, in cards.

        One card per question, with the question as its heading, rather than a single scroll of
        switches separated by rules. A page of settings is easiest to read when the eye can tell
        where one decision ends and the next begins without reading either.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,28" Spacing="14">

            <Label
                Margin="4,4,0,0"
                Style="{StaticResource Display}"
                Text="Postavke" />

            <!--  ======== How hard it may work the phone ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Style="{StaticResource Section}" Text="Opterećenje telefona" />

                    <Label
                        Style="{StaticResource Muted}"
                        Text="Poravnanje sluša samo desetinu snimke, pa i najsporija postavka završi knjigu puno prije nego je stigneš odslušati." />

                    <CollectionView
                        x:Name="BudgetList"
                        ItemsSource="{Binding Budgets}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BudgetOption">
                                <Grid
                                    Padding="0,10"
                                    ColumnDefinitions="26,*"
                                    ColumnSpacing="6">

                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBudgetTapped" />
                                    </Grid.GestureRecognizers>

                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        IsVisible="{Binding IsSelected}"
                                        Text="✓"
                                        TextColor="{AppThemeBinding Light={StaticResource Accent},
                                                                    Dark={StaticResource AccentDark}}"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
                                        <Label FontSize="13" Text="{Binding Estimate}" />
                                        <Label Style="{StaticResource Muted}" Text="{Binding Detail}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!--  ======== When it may work at all ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Style="{StaticResource Section}" Text="Kad smije raditi" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Samo dok se puni"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ChargingOnly}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Samo dok je ekran ugašen"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ScreenOffOnly}" />
                    </Grid>

                    <BoxView Style="{StaticResource Divider}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding MinimumBatteryText}" />
                        <Slider
                            Maximum="90"
                            Minimum="0"
                            Value="{Binding MinimumBatteryPercent}" />
                    </VerticalStackLayout>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="Poravnanje se samo pauzira i nastavlja — nikad ne gubi napredak. Uz to se samo usporava ako se telefon zagrije, bez obzira na odabrano." />
                </VerticalStackLayout>
            </Border>

            <!--  ======== Diagnostics ========  -->

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">

                    <Label Style="{StaticResource Section}" Text="Dijagnostika" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="Detaljan zapis u log"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding VerboseLog}" />
                    </Grid>

                    <Label
                        Style="{StaticResource Muted}"
                        Text="Uključi samo ako nešto treba dijagnosticirati — piše nekoliko puta u sekundi dok je knjiga otvorena." />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
