<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="BookRoot"
    x:Class="AudioBookReader.App.Views.BookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:BookViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}">

    <!--
        The player is the screen, not a section of one: cover, chapter, position, transport, and
        nothing else competing for the space. Everything you do to a book once — files, alignment,
        deletion — is behind the ☰ button, because it was making the daily half look like a form.
    -->

    <Grid Padding="14,8" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="6">

        <!--  Top bar  -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
            <Button
                Grid.Column="0"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />

            <Button
                Grid.Column="2"
                Command="{Binding ChooseSleepCommand}"
                IsVisible="{Binding HasAudio}"
                Style="{StaticResource Icon}"
                Text="⏱" />

            <!--
                Tap opens the list, hold saves the spot. A flag glyph rather than the emoji:
                the rest of this bar is flat monochrome text, and a coloured pictogram among
                them read as something pasted in from another app.
            -->
            <Button
                Grid.Column="3"
                FontSize="20"
                IsVisible="{Binding HasAudio}"
                Pressed="OnBookmarkPressed"
                Released="OnBookmarkReleased"
                Style="{StaticResource Icon}"
                Text="⚑" />

            <!--  A number says more about speed than any gauge glyph could.  -->
            <Button
                Grid.Column="4"
                Command="{Binding CycleSpeedCommand}"
                IsVisible="{Binding HasAudio}"
                Style="{StaticResource Icon}"
                Text="{Binding SpeedText}" />

            <Button
                Grid.Column="5"
                Command="{Binding OpenDetailsCommand}"
                Style="{StaticResource Icon}"
                Text="☰" />
        </Grid>

        <!--  Countdown, shown only while a timer is armed.  -->
        <Label
            Grid.Row="0"
            HorizontalOptions="Center"
            IsVisible="{Binding HasSleepTimer}"
            Style="{StaticResource Muted}"
            Text="{Binding SleepButtonText}"
            VerticalOptions="Center" />

        <!--  Confirms a held flag actually saved something.  -->
        <Label
            Grid.Row="1"
            HorizontalOptions="Center"
            IsVisible="{Binding HasBookmarkNote}"
            Style="{StaticResource Muted}"
            Text="{Binding BookmarkNote}"
            VerticalOptions="Start" />

        <!--  Cover, with the chapter list opening over it  -->
        <Grid Grid.Row="1" Margin="0,10">
            <Border
                HorizontalOptions="Center"
                IsVisible="{Binding HasCover}"
                Margin="24,0"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
                <Image Aspect="AspectFit" Source="{Binding CoverPath}" />
            </Border>

            <!--
                No cover, so the book says its own name. Set on the same warm ground a cover would
                have occupied, at the same size, so a shelf of books with and without covers does
                not jump about.
            -->
            <Border
                IsVisible="{Binding HasNoCover}"
                Margin="34"
                Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Display}"
                        Text="{Binding Title}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Muted}"
                        Text="{Binding Author}" />
                </VerticalStackLayout>
            </Border>

            <!--  Chapter list  -->
            <Border
                IsVisible="{Binding ChaptersExpanded}"
                Padding="6"
                Style="{StaticResource Card}">

                <CollectionView ItemsSource="{Binding Chapters}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChapterRow">
                            <Grid Padding="10,12" ColumnDefinitions="20,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.SelectChapterCommand, Source={x:Reference BookRoot}}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Grid.Column="0"
                                    FontSize="12"
                                    Text="{Binding Marker}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="{Binding TitleWeight}"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Title}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="2"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding StartText}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </Grid>

        <!--  Chapter bar: tapping the title opens and closes the list  -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="46,*,46"
            IsVisible="{Binding HasAudio}">
            <Button
                Grid.Column="0"
                Command="{Binding PreviousChapterCommand}"
                Style="{StaticResource Icon}"
                Text="‹" />

            <Label
                Grid.Column="1"
                FontFamily="OpenSansSemibold"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                Text="{Binding ChapterHeading}"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleChaptersCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Button
                Grid.Column="2"
                Command="{Binding NextChapterCommand}"
                Style="{StaticResource Icon}"
                Text="›" />
        </Grid>

        <!--  Position within the chapter  -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="Auto,*,Auto"
            IsVisible="{Binding HasAudio}">
            <Label
                Grid.Column="0"
                Style="{StaticResource Muted}"
                Text="{Binding PositionText}"
                VerticalOptions="Center" />

            <!--
                The part already heard is a solid block sitting on the baseline; what is left
                is a hairline. Weight rather than tint, because weight reads at a glance — and
                a block that grows along a line is a different shape from the usual filled pill
                with a knob riding on it.
            -->
            <Grid
                x:Name="Track"
                Grid.Column="1"
                Margin="10,0"
                HeightRequest="34"
                SizeChanged="OnTrackSizeChanged">

                <BoxView
                    BackgroundColor="{AppThemeBinding Light={StaticResource Line},
                                                      Dark={StaticResource LineDark}}"
                    HeightRequest="1"
                    VerticalOptions="Center" />

                <BoxView
                    BackgroundColor="{AppThemeBinding Light={StaticResource Accent},
                                                      Dark={StaticResource AccentDark}}"
                    HeightRequest="12"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    WidthRequest="{Binding PlayedWidth}" />

                <Slider
                    x:Name="Scrubber"
                    DragCompleted="OnScrubberDragCompleted"
                    Maximum="1"
                    MaximumTrackColor="Transparent"
                    Minimum="0"
                    MinimumTrackColor="Transparent"
                    ThumbColor="Transparent"
                    Value="{Binding Progress, Mode=OneWay}" />
            </Grid>

            <Label
                Grid.Column="2"
                Style="{StaticResource Muted}"
                Text="{Binding DurationText}"
                VerticalOptions="Center" />
        </Grid>

        <!--  Transport  -->
        <HorizontalStackLayout
            Grid.Row="4"
            HorizontalOptions="Center"
            IsVisible="{Binding HasAudio}"
            Margin="0,6"
            Spacing="30">
            <Button
                Command="{Binding BackCommand}"
                Style="{StaticResource Skip}"
                Text="↺10" />

            <Button
                Command="{Binding TogglePlayCommand}"
                Style="{StaticResource Play}"
                Text="{Binding PlayGlyph}" />

            <Button
                Command="{Binding ForwardCommand}"
                Style="{StaticResource Skip}"
                Text="↻10" />
        </HorizontalStackLayout>

        <!--
            Back to the text, and a one-line word on alignment when there is one.

            Only a paired book ever shows this, and for a paired book the reader is where the
            book opens — so this is the way back to it rather than the way in. An audiobook with
            no text has nothing to read and is not offered any.
        -->
        <VerticalStackLayout Grid.Row="5" Spacing="4">
            <Button
                Command="{Binding OpenReaderCommand}"
                HorizontalOptions="Center"
                IsVisible="{Binding HasText}"
                Style="{StaticResource Secondary}"
                Text="{x:Static s:Strings.Player_Read}" />

            <Label
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsAligning}"
                Style="{StaticResource Muted}"
                Text="{Binding AlignmentMessage}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
