<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ServerRoot"
    x:Class="AudioBookReader.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ServerViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PaperBackground},
                                      Dark={StaticResource PaperBackgroundDark}}"
    Shell.NavBarIsVisible="False"
    Title="Server">

    <!--
        Connecting to an Audiobookshelf server, and taking books off it.

        The sign-in half disappears once connected, because it is a thing you do once. What stays is
        the library: pick which one, then the books in it.
    -->

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,10">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button
                Grid.Column="0"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />

            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="17"
                Text="Audiobookshelf"
                VerticalOptions="Center" />

            <Button
                Grid.Column="2"
                Command="{Binding RefreshCommand}"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource Icon}"
                Text="⟳" />
        </Grid>

        <!--  Signing in  -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsDisconnected}"
            Spacing="10">

            <Label
                Style="{StaticResource Muted}"
                Text="Adresa servera, npr. 192.168.1.10:13378" />

            <Entry Keyboard="Url" Text="{Binding Url}" />

            <!--
                Two ways in. A token is the better one and is offered first-class rather than hidden:
                it can be revoked from the server without changing the account password, and the
                password then never has to be typed into this app at all.
            -->
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Text="Prijava tokenom umjesto lozinkom"
                    VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UsesToken}" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding UsesPassword}" Spacing="10">
                <Entry Placeholder="Korisničko ime" Text="{Binding Username}" />
                <Entry
                    IsPassword="True"
                    Placeholder="Lozinka"
                    Text="{Binding Password}" />
            </VerticalStackLayout>

            <Entry
                IsPassword="True"
                IsVisible="{Binding UsesToken}"
                Placeholder="API token sa stranice tvog računa"
                Text="{Binding Token}" />

            <Button
                Command="{Binding ConnectCommand}"
                Style="{StaticResource Plain}"
                Text="Poveži se" />

            <Label
                Style="{StaticResource Muted}"
                Text="Lozinka se ne sprema. Zamijeni se za token, a token stoji u zaštićenom spremniku uređaja." />
        </VerticalStackLayout>

        <!--  Which library on the server  -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsConnected}"
            Spacing="6">

            <Label Style="{StaticResource Muted}" Text="{Binding Url}" />

            <Picker
                ItemDisplayBinding="{Binding Name}"
                ItemsSource="{Binding Libraries}"
                SelectedItem="{Binding SelectedLibrary}" />
        </VerticalStackLayout>

        <!--  The books  -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Books}"
            Margin="0,10"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerBookRow">
                    <Grid Padding="0,12" ColumnDefinitions="*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Path=BindingContext.ImportCommand, Source={x:Reference ServerRoot}}"
                                CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label LineBreakMode="TailTruncation" Text="{Binding Title}" />
                            <Label Style="{StaticResource Muted}" Text="{Binding Author}" />
                            <Label Style="{StaticResource Muted}" Text="{Binding Note}" />
                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="{Binding Media}"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <ProgressBar IsVisible="{Binding IsBusy}" Progress="{Binding Progress}" />

            <HorizontalStackLayout IsVisible="{Binding HasStatus}" Spacing="10">
                <ActivityIndicator
                    HeightRequest="14"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    WidthRequest="14" />

                <Label
                    Style="{StaticResource Muted}"
                    Text="{Binding Status}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Command="{Binding DisconnectCommand}"
                FontSize="13"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource Icon}"
                Text="Odspoji se"
                WidthRequest="-1" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
