<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ServerRoot"
    x:Class="AudioBookReader.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ServerViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PaperBackground},
                                      Dark={StaticResource PaperBackgroundDark}}"
    Shell.NavBarIsVisible="False"
    Title="Server">

    <!--
        Books on an Audiobookshelf server, and bringing them here.

        Arranged the way shelves are: the newest arrivals, then each series in reading order, then
        everything that belongs to no series — each one a title and a row of covers pushed sideways.
        Covers rather than lines of text, because that is how anyone recognises a book they own.

        The sign-in half disappears once connected. It is a thing you do once.
    -->

    <ContentPage.Resources>
        <Style x:Key="Cover" TargetType="Image">
            <Setter Property="Aspect" Value="AspectFill" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E4DFD6, Dark=#1B2029}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14,10">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button
                Grid.Column="0"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />

            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="17"
                Text="Audiobookshelf"
                VerticalOptions="Center" />

            <Button
                Grid.Column="2"
                Command="{Binding RefreshCommand}"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource Icon}"
                Text="⟳" />
        </Grid>

        <!--  Signing in  -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsDisconnected}"
            Spacing="10">

            <Label Style="{StaticResource Muted}" Text="Adresa servera, npr. 192.168.1.10:13378" />

            <Entry Keyboard="Url" Text="{Binding Url}" />

            <!--
                Two ways in. A token is the better one and is offered as an equal rather than hidden:
                it can be revoked from the server without changing the account password, and the
                password then never has to be typed into this app at all.
            -->
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Text="Prijava tokenom umjesto lozinkom"
                    VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UsesToken}" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding UsesPassword}" Spacing="10">
                <Entry Placeholder="Korisničko ime" Text="{Binding Username}" />
                <Entry
                    IsPassword="True"
                    Placeholder="Lozinka"
                    Text="{Binding Password}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="Zapamti prijavu"
                        VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding RemembersSignIn}" />
                </Grid>
            </VerticalStackLayout>

            <Entry
                IsPassword="True"
                IsVisible="{Binding UsesToken}"
                Placeholder="API token sa stranice tvog računa"
                Text="{Binding Token}" />

            <Button
                Command="{Binding ConnectCommand}"
                Style="{StaticResource Plain}"
                Text="Poveži se" />

            <Label
                Style="{StaticResource Muted}"
                Text="Sve stoji u zaštićenom spremniku uređaja, uz ključ u sustavskom keystoreu. Bez „Zapamti prijavu” ostaješ prijavljen 30 dana od zadnjeg otvaranja aplikacije." />
        </VerticalStackLayout>

        <!--  Which library on the server  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            IsVisible="{Binding IsConnected}">

            <Picker
                Grid.Column="0"
                ItemDisplayBinding="{Binding Name}"
                ItemsSource="{Binding Libraries}"
                SelectedItem="{Binding SelectedLibrary}" />

            <Label
                Grid.Column="1"
                Style="{StaticResource Muted}"
                Text="{Binding Url}"
                VerticalOptions="Center" />
        </Grid>

        <!--
            One shelf per row, and one kind of shelf.

            The newest arrivals, each series, and everything with no series are all the same thing:
            a title and a row of covers you push sideways. Nothing behaves differently because of
            where it sits, and there is one template to get right.

            One scrolling element vertically, too. A CollectionView inside a ScrollView loses its
            virtualisation — it has to measure itself to an unbounded height, so every row is built
            at once and every cover starts downloading in the same instant, which is what made this
            stutter. Each shelf has a fixed height instead, so the outer list can measure a row
            without building the rest.
        -->
        <CollectionView
            Grid.Row="2"
            ItemSizingStrategy="MeasureFirstItem"
            ItemsSource="{Binding Shelves}"
            Margin="0,8"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:Shelf">
                    <VerticalStackLayout Padding="0,10,0,4" Spacing="6">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Name}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Muted}"
                                Text="{Binding Summary}"
                                VerticalOptions="Center" />
                        </Grid>

                        <!--
                            A horizontal list with a fixed height. Horizontal virtualisation works
                            here precisely because the height is not in question — which is the
                            difference between this and a list inside a ScrollView.
                        -->
                        <CollectionView
                            HeightRequest="196"
                            ItemsSource="{Binding .}"
                            SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerBookRow">
                                    <VerticalStackLayout Spacing="4" WidthRequest="104">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.ImportCommand, Source={x:Reference ServerRoot}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <Grid HeightRequest="150" WidthRequest="104">
                                            <Border StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding CoverUrl}" Style="{StaticResource Cover}" />
                                            </Border>

                                            <!--  What the server has of it, over the corner of the cover.  -->
                                            <Label
                                                FontSize="11"
                                                HorizontalOptions="End"
                                                Margin="4"
                                                Text="{Binding Media}"
                                                VerticalOptions="Start" />

                                            <Label
                                                BackgroundColor="{AppThemeBinding Light=#F1EDE5,
                                                                                  Dark=#15181E}"
                                                FontSize="11"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding IsNumbered}"
                                                Margin="4"
                                                Padding="4,1"
                                                Text="{Binding Number}"
                                                VerticalOptions="End" />
                                        </Grid>

                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding Title}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  What is happening, and the way to stop it  -->
        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <HorizontalStackLayout IsVisible="{Binding HasStatus}" Spacing="10">
                <ActivityIndicator
                    HeightRequest="14"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    WidthRequest="14" />

                <Label
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource Muted}"
                    Text="{Binding Status}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Command="{Binding DisconnectCommand}"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource IconWide}"
                Text="Odspoji se" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
