<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ServerRoot"
    x:Class="AudioBookReader.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ServerViewModel"
    Shell.NavBarIsVisible="False"
    Title="{x:Static s:Strings.Server_Title}">

    <!--
        Books on an Audiobookshelf server, and bringing them here.

        Arranged the way shelves are: the newest arrivals, then each series in reading order, then
        everything that belongs to no series — each one a title and a row of covers pushed sideways.
        Covers rather than lines of text, because that is how anyone recognises a book they own.

        The sign-in half disappears once connected. It is a thing you do once.
    -->

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="14,10">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="4">

            <Button
                Grid.Column="0"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />

            <!--
                The address belongs here, under the name, not beside the library chooser.

                It used to sit in an auto-width column next to that chooser, which meant a long
                address took whatever width it wanted and left the chooser showing four letters of
                its library. An address is not a control — it says which server you are looking at,
                which is what a heading is for, and it can be truncated without losing that.
            -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                VerticalOptions="Center">

                <Label
                    FontAttributes="Bold"
                    FontSize="17"
                    Text="{x:Static s:Strings.Server_Title}" />

                <Label
                    FontSize="11"
                    IsVisible="{Binding IsConnected}"
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource Muted}"
                    Text="{Binding Url}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Command="{Binding RefreshCommand}"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource Icon}"
                Text="⟳" />
        </Grid>

        <!--
            The servers, one pill each, and a way to add another up to five. The highlighted one is
            the one on screen; every book remembers which one it came from regardless.
        -->
        <ScrollView
            Grid.Row="1"
            HorizontalScrollBarVisibility="Never"
            IsVisible="{Binding ShowsServers}"
            Orientation="Horizontal">
            <HorizontalStackLayout Padding="0,6,0,2" Spacing="8">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Servers}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerChip">
                            <Border
                                Padding="14,6"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsActive}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsActive}"
                                        TargetType="Border"
                                        Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.SwitchServerCommand, Source={x:Reference ServerRoot}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    Text="{Binding Name}">
                                    <Label.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsActive}"
                                            TargetType="Label"
                                            Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccent}, Dark={StaticResource OnAccentDark}}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>

                <Button
                    Command="{Binding AddServerCommand}"
                    IsVisible="{Binding CanAddServer}"
                    SemanticProperties.Description="{x:Static s:Strings.Server_AddServer}"
                    Style="{StaticResource IconWide}"
                    Text="{x:Static s:Strings.Server_AddServerShort}" />
            </HorizontalStackLayout>
        </ScrollView>

        <!--  Signing in. A card, so it reads as one form rather than a column of loose fields.  -->
        <!--
            Scrollable, over the space the book list takes once connected: on a television the
            form is taller than the screen, and with nothing to scroll the remote's Down went from
            the password straight to the tab bar and the Connect button could never be reached.
            A scroll view brings whatever has focus into view.
        -->
        <ScrollView
            Grid.Row="2"
            Grid.RowSpan="2"
            IsVisible="{Binding IsDisconnected}">
        <Border
            Margin="0,8"
            Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="10">

                <!--  What to call it, so several servers can be told apart. Optional.  -->
                <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Server_Name}" />
                <Entry Placeholder="{x:Static s:Strings.Server_NamePlaceholder}" Text="{Binding ServerName}" />

                <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Server_Address}" />

                <!--  Smaller type, because a server address is long and is read once.  -->
                <Entry
                    FontSize="14"
                    Keyboard="Url"
                    Placeholder="https://"
                    Text="{Binding Url}" />

                <!--
                    Two ways in. A token is the better one and is offered as an equal rather than
                    hidden: it can be revoked from the server without changing the account password,
                    and the password then never has to be typed into this app at all.
                -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="{x:Static s:Strings.Server_UseToken}"
                        VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding UsesToken}" />
                </Grid>

                <VerticalStackLayout IsVisible="{Binding UsesPassword}" Spacing="10">
                    <Entry Placeholder="{x:Static s:Strings.Server_Username}" Text="{Binding Username}" />
                    <!--  Hold the eye to see what was typed; letting go hides it again.  -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry
                            x:Name="PasswordEntry"
                            Grid.Column="0"
                            IsPassword="True"
                            Placeholder="{x:Static s:Strings.Server_Password}"
                            ReturnCommand="{Binding ConnectCommand}"
                            ReturnType="Go"
                            Text="{Binding Password}" />
                        <ImageButton
                            Grid.Column="1"
                            Padding="8"
                            BackgroundColor="Transparent"
                            HeightRequest="44"
                            Pressed="OnShowPasswordPressed"
                            Released="OnShowPasswordReleased"
                            SemanticProperties.Description="{x:Static s:Strings.Server_ShowPassword}"
                            Source="eye.png"
                            WidthRequest="44" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Server_RememberSignIn}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RemembersSignIn}" />
                    </Grid>
                </VerticalStackLayout>

                <Entry
                    IsPassword="True"
                    IsVisible="{Binding UsesToken}"
                    Placeholder="{x:Static s:Strings.Server_TokenPlaceholder}"
                    ReturnCommand="{Binding ConnectCommand}"
                    ReturnType="Go"
                    Text="{Binding Token}" />

                <BoxView Style="{StaticResource Divider}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="{x:Static s:Strings.Server_TrustAnyCertificate}"
                        VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding TrustAnyCertificate}" />
                </Grid>

                <Label
                    IsVisible="{Binding TrustAnyCertificate}"
                    Style="{StaticResource Failure}"
                    Text="{x:Static s:Strings.Server_TrustAnyCertificateWarning}" />

                <Button
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource Primary}"
                    Text="{x:Static s:Strings.Server_Connect}" />

                <!--
                    Right under the button that started it, and in full: the page's own status line is
                    one truncated row at the foot of the screen, and a failed sign-in there went unseen.
                -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding IsConnecting}"
                    Spacing="10">
                    <ActivityIndicator
                        HeightRequest="24"
                        IsRunning="{Binding IsConnecting}"
                        VerticalOptions="Center"
                        WidthRequest="24"
                        Color="{AppThemeBinding Light={StaticResource Accent},
                                                Dark={StaticResource AccentDark}}" />
                    <Label
                        Style="{StaticResource Muted}"
                        Text="{x:Static s:Strings.Server_Connecting}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label
                    IsVisible="{Binding HasConnectError}"
                    Style="{StaticResource Failure}"
                    Text="{Binding ConnectError}" />

                <Label
                    Style="{StaticResource Muted}"
                    Text="{x:Static s:Strings.Server_SecurityNote}" />
            </VerticalStackLayout>
        </Border>
        </ScrollView>

        <!--  Which library on the server, with the whole row to show its name in.  -->
        <Picker
            Grid.Row="2"
            IsVisible="{Binding IsConnected}"
            ItemDisplayBinding="{Binding Name}"
            ItemsSource="{Binding Libraries}"
            SelectedItem="{Binding SelectedLibrary}" />

        <!--
            One shelf per row, and one kind of shelf.

            The newest arrivals, each series, and everything with no series are all the same thing:
            a title and a row of covers you push sideways. Nothing behaves differently because of
            where it sits, and there is one template to get right.

            One scrolling element vertically, too. A CollectionView inside a ScrollView loses its
            virtualisation — it has to measure itself to an unbounded height, so every row is built
            at once and every cover starts downloading in the same instant, which is what made this
            stutter. Each shelf has a fixed height instead, so the outer list can measure a row
            without building the rest.
        -->
        <CollectionView
            Grid.Row="3"
            ItemSizingStrategy="MeasureFirstItem"
            ItemsSource="{Binding Shelves}"
            Margin="0,8"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:Shelf">
                    <VerticalStackLayout Padding="0,10,0,4" Spacing="6">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Name}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Muted}"
                                Text="{Binding Summary}"
                                VerticalOptions="Center" />
                        </Grid>

                        <!--
                            A horizontal list with a fixed height. Horizontal virtualisation works
                            here precisely because the height is not in question — which is the
                            difference between this and a list inside a ScrollView.
                        -->
                        <CollectionView
                            HeightRequest="196"
                            ItemsSource="{Binding .}"
                            SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerBookRow">
                                    <VerticalStackLayout Spacing="4" WidthRequest="104">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.ImportCommand, Source={x:Reference ServerRoot}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <Grid HeightRequest="150" WidthRequest="104">
                                            <Border StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding CoverUrl}" Style="{StaticResource Cover}" />
                                            </Border>

                                            <!--  What the server has of it, over the corner of the cover.  -->
                                            <Label
                                                FontSize="11"
                                                HorizontalOptions="End"
                                                Margin="4"
                                                Text="{Binding Media}"
                                                VerticalOptions="Start" />

                                            <Label
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                                                                  Dark={StaticResource ChromeDark}}"
                                                FontSize="11"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding IsNumbered}"
                                                Margin="4"
                                                Padding="4,1"
                                                Text="{Binding Number}"
                                                VerticalOptions="End" />
                                        </Grid>

                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding Title}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  What is happening, and the way to stop it  -->
        <VerticalStackLayout Grid.Row="4" Spacing="6">
            <HorizontalStackLayout IsVisible="{Binding HasStatus}" Spacing="10">
                <ActivityIndicator
                    HeightRequest="14"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    WidthRequest="14" />

                <Label
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource Muted}"
                    Text="{Binding Status}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Command="{Binding DisconnectCommand}"
                HorizontalOptions="Start"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource IconWide}"
                Text="{x:Static s:Strings.Server_Disconnect}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
