<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ServerRoot"
    x:Class="AudioBookReader.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ServerViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PaperBackground},
                                      Dark={StaticResource PaperBackgroundDark}}"
    Shell.NavBarIsVisible="False"
    Title="Server">

    <!--
        Books on an Audiobookshelf server, and bringing them here.

        Arranged the way a shelf is: the newest arrivals along the top, then each series in reading
        order, then everything that belongs to no series. Covers rather than lines of text, because
        that is how anyone actually recognises a book they own.

        The sign-in half disappears once connected. It is a thing you do once.
    -->

    <ContentPage.Resources>
        <Style x:Key="Cover" TargetType="Image">
            <Setter Property="Aspect" Value="AspectFill" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E4DFD6, Dark=#1B2029}" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14,10">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button
                Grid.Column="0"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />

            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="17"
                Text="Audiobookshelf"
                VerticalOptions="Center" />

            <Button
                Grid.Column="2"
                Command="{Binding RefreshCommand}"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource Icon}"
                Text="⟳" />
        </Grid>

        <!--  Signing in  -->
        <VerticalStackLayout
            Grid.Row="1"
            IsVisible="{Binding IsDisconnected}"
            Spacing="10">

            <Label Style="{StaticResource Muted}" Text="Adresa servera, npr. 192.168.1.10:13378" />

            <Entry Keyboard="Url" Text="{Binding Url}" />

            <!--
                Two ways in. A token is the better one and is offered as an equal rather than hidden:
                it can be revoked from the server without changing the account password, and the
                password then never has to be typed into this app at all.
            -->
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Grid.Column="0"
                    Text="Prijava tokenom umjesto lozinkom"
                    VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding UsesToken}" />
            </Grid>

            <VerticalStackLayout IsVisible="{Binding UsesPassword}" Spacing="10">
                <Entry Placeholder="Korisničko ime" Text="{Binding Username}" />
                <Entry
                    IsPassword="True"
                    Placeholder="Lozinka"
                    Text="{Binding Password}" />
            </VerticalStackLayout>

            <Entry
                IsPassword="True"
                IsVisible="{Binding UsesToken}"
                Placeholder="API token sa stranice tvog računa"
                Text="{Binding Token}" />

            <Button
                Command="{Binding ConnectCommand}"
                Style="{StaticResource Plain}"
                Text="Poveži se" />

            <Label
                Style="{StaticResource Muted}"
                Text="Lozinka se ne sprema. Zamijeni se za token, a token stoji u zaštićenom spremniku uređaja." />
        </VerticalStackLayout>

        <!--  Which library on the server  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            IsVisible="{Binding IsConnected}">

            <Picker
                Grid.Column="0"
                ItemDisplayBinding="{Binding Name}"
                ItemsSource="{Binding Libraries}"
                SelectedItem="{Binding SelectedLibrary}" />

            <Label
                Grid.Column="1"
                Style="{StaticResource Muted}"
                Text="{Binding Url}"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="2" Margin="0,8">
            <VerticalStackLayout Spacing="14">

                <!--  Newest arrivals, along the top and sideways  -->
                <VerticalStackLayout IsVisible="{Binding HasRecent}" Spacing="6">
                    <Label FontAttributes="Bold" Text="Nedavno dodano" />

                    <CollectionView
                        HeightRequest="210"
                        ItemsSource="{Binding Recent}"
                        SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServerBookRow">
                                <VerticalStackLayout Spacing="4" WidthRequest="110">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Path=BindingContext.ImportCommand, Source={x:Reference ServerRoot}}"
                                            CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Border HeightRequest="160" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <Image Source="{Binding CoverUrl}" Style="{StaticResource Cover}" />
                                    </Border>

                                    <Label
                                        FontSize="12"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="2"
                                        Text="{Binding Title}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!--  Everything, by series  -->
                <CollectionView
                    IsGrouped="True"
                    ItemsSource="{Binding Shelves}"
                    SelectionMode="None">

                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="vm:Shelf">
                            <Grid Padding="0,14,0,6" ColumnDefinitions="*,Auto">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Name}" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Summary}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerBookRow">
                            <Grid
                                Padding="0,6"
                                ColumnDefinitions="52,Auto,*,Auto"
                                ColumnSpacing="10">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Path=BindingContext.ImportCommand, Source={x:Reference ServerRoot}}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Border
                                    Grid.Column="0"
                                    HeightRequest="74"
                                    StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Image Source="{Binding CoverUrl}" Style="{StaticResource Cover}" />
                                </Border>

                                <Label
                                    Grid.Column="1"
                                    IsVisible="{Binding IsNumbered}"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Number}"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label LineBreakMode="TailTruncation" Text="{Binding Title}" />
                                    <Label
                                        LineBreakMode="TailTruncation"
                                        Style="{StaticResource Muted}"
                                        Text="{Binding Author}" />
                                    <Label Style="{StaticResource Muted}" Text="{Binding Note}" />
                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="3"
                                    Text="{Binding Media}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!--  What is happening, and the way to stop it  -->
        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <ProgressBar IsVisible="{Binding IsDownloading}" Progress="{Binding Progress}" />

            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStatus}">
                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <ActivityIndicator
                        HeightRequest="14"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        VerticalOptions="Center"
                        WidthRequest="14" />

                    <Label
                        LineBreakMode="TailTruncation"
                        Style="{StaticResource Muted}"
                        Text="{Binding Status}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button
                    Grid.Column="1"
                    Command="{Binding CancelDownloadCommand}"
                    IsVisible="{Binding IsDownloading}"
                    Style="{StaticResource IconWide}"
                    Text="Prekini" />
            </Grid>

            <Button
                Command="{Binding DisconnectCommand}"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource IconWide}"
                Text="Odspoji se" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
