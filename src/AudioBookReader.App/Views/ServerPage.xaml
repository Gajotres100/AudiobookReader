<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="ServerRoot"
    x:Class="AudioBookReader.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ServerViewModel"
    Shell.NavBarIsVisible="False"
    Title="{x:Static s:Strings.Server_Title}">

    <!--
        Books on an Audiobookshelf server, and bringing them here.

        Arranged the way shelves are: the newest arrivals, then each series in reading order, then
        everything that belongs to no series — each one a title and a row of covers pushed sideways.
        Covers rather than lines of text, because that is how anyone recognises a book they own.

        The sign-in half disappears once connected. It is a thing you do once.
    -->

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="14,10">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="4">

            <Button
                Grid.Column="0"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />

            <!--
                The address belongs here, under the name, not beside the library chooser.

                It used to sit in an auto-width column next to that chooser, which meant a long
                address took whatever width it wanted and left the chooser showing four letters of
                its library. An address is not a control — it says which server you are looking at,
                which is what a heading is for, and it can be truncated without losing that.
            -->
            <VerticalStackLayout
                Grid.Column="1"
                Spacing="0"
                VerticalOptions="Center">

                <Label
                    FontAttributes="Bold"
                    FontSize="17"
                    Text="{x:Static s:Strings.Server_Title}" />

                <Label
                    FontSize="11"
                    IsVisible="{Binding IsConnected}"
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource Muted}"
                    Text="{Binding Url}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="2"
                Command="{Binding RefreshCommand}"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource Icon}"
                Text="⟳" />
        </Grid>

        <!--  Signing in. A card, so it reads as one form rather than a column of loose fields.  -->
        <Border
            Grid.Row="1"
            IsVisible="{Binding IsDisconnected}"
            Margin="0,8"
            Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="10">

                <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Server_Address}" />

                <!--  Smaller type, because a server address is long and is read once.  -->
                <Entry
                    FontSize="14"
                    Keyboard="Url"
                    Placeholder="https://"
                    Text="{Binding Url}" />

                <!--
                    Two ways in. A token is the better one and is offered as an equal rather than
                    hidden: it can be revoked from the server without changing the account password,
                    and the password then never has to be typed into this app at all.
                -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Text="{x:Static s:Strings.Server_UseToken}"
                        VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding UsesToken}" />
                </Grid>

                <VerticalStackLayout IsVisible="{Binding UsesPassword}" Spacing="10">
                    <Entry Placeholder="{x:Static s:Strings.Server_Username}" Text="{Binding Username}" />
                    <Entry
                        IsPassword="True"
                        Placeholder="{x:Static s:Strings.Server_Password}"
                        Text="{Binding Password}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Text="{x:Static s:Strings.Server_RememberSignIn}"
                            VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding RemembersSignIn}" />
                    </Grid>
                </VerticalStackLayout>

                <Entry
                    IsPassword="True"
                    IsVisible="{Binding UsesToken}"
                    Placeholder="{x:Static s:Strings.Server_TokenPlaceholder}"
                    Text="{Binding Token}" />

                <Button
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource Primary}"
                    Text="{x:Static s:Strings.Server_Connect}" />

                <Label
                    Style="{StaticResource Muted}"
                    Text="{x:Static s:Strings.Server_SecurityNote}" />
            </VerticalStackLayout>
        </Border>

        <!--  Which library on the server, with the whole row to show its name in.  -->
        <Picker
            Grid.Row="1"
            IsVisible="{Binding IsConnected}"
            ItemDisplayBinding="{Binding Name}"
            ItemsSource="{Binding Libraries}"
            SelectedItem="{Binding SelectedLibrary}" />

        <!--
            One shelf per row, and one kind of shelf.

            The newest arrivals, each series, and everything with no series are all the same thing:
            a title and a row of covers you push sideways. Nothing behaves differently because of
            where it sits, and there is one template to get right.

            One scrolling element vertically, too. A CollectionView inside a ScrollView loses its
            virtualisation — it has to measure itself to an unbounded height, so every row is built
            at once and every cover starts downloading in the same instant, which is what made this
            stutter. Each shelf has a fixed height instead, so the outer list can measure a row
            without building the rest.
        -->
        <CollectionView
            Grid.Row="2"
            ItemSizingStrategy="MeasureFirstItem"
            ItemsSource="{Binding Shelves}"
            Margin="0,8"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:Shelf">
                    <VerticalStackLayout Padding="0,10,0,4" Spacing="6">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Name}" />
                            <Label
                                Grid.Column="1"
                                Style="{StaticResource Muted}"
                                Text="{Binding Summary}"
                                VerticalOptions="Center" />
                        </Grid>

                        <!--
                            A horizontal list with a fixed height. Horizontal virtualisation works
                            here precisely because the height is not in question — which is the
                            difference between this and a list inside a ScrollView.
                        -->
                        <CollectionView
                            HeightRequest="196"
                            ItemsSource="{Binding .}"
                            SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServerBookRow">
                                    <VerticalStackLayout Spacing="4" WidthRequest="104">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.ImportCommand, Source={x:Reference ServerRoot}}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <Grid HeightRequest="150" WidthRequest="104">
                                            <Border StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Image Source="{Binding CoverUrl}" Style="{StaticResource Cover}" />
                                            </Border>

                                            <!--  What the server has of it, over the corner of the cover.  -->
                                            <Label
                                                FontSize="11"
                                                HorizontalOptions="End"
                                                Margin="4"
                                                Text="{Binding Media}"
                                                VerticalOptions="Start" />

                                            <Label
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                                                                  Dark={StaticResource ChromeDark}}"
                                                FontSize="11"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding IsNumbered}"
                                                Margin="4"
                                                Padding="4,1"
                                                Text="{Binding Number}"
                                                VerticalOptions="End" />
                                        </Grid>

                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding Title}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--  What is happening, and the way to stop it  -->
        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <HorizontalStackLayout IsVisible="{Binding HasStatus}" Spacing="10">
                <ActivityIndicator
                    HeightRequest="14"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center"
                    WidthRequest="14" />

                <Label
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource Muted}"
                    Text="{Binding Status}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Command="{Binding DisconnectCommand}"
                HorizontalOptions="Start"
                IsVisible="{Binding IsConnected}"
                Style="{StaticResource IconWide}"
                Text="{x:Static s:Strings.Server_Disconnect}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
