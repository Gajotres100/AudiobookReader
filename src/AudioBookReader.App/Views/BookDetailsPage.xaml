<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.BookDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:BookViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}">

    <!--
        Everything you do to a book once: which files it is made of, whether the text is aligned to
        the narration, and deleting it.

        A page of its own rather than a panel over the player, because a text-only book has no
        player to put a panel over — and having one place for all three kinds of book is the whole
        point of splitting them apart.

        Grouped into cards, one per question. It was a single column of controls before, which read
        as a form: everything looked equally important and nothing said where one decision ended and
        the next began.
    -->

    <Grid RowDefinitions="Auto,*">

        <Grid
            Grid.Row="0"
            Padding="20,14,12,6"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                <Label
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource Heading}"
                    Text="{Binding Title}" />
                <Label
                    LineBreakMode="TailTruncation"
                    Style="{StaticResource Muted}"
                    Text="{Binding Author}" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,28" Spacing="14">

                <Label
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource Failure}"
                    Text="{Binding Error}" />

                <!--  Copying an audiobook is the slow part of an import; say how far along it is.  -->
                <Border IsVisible="{Binding IsImporting}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ImportMessage}" />
                        <ProgressBar Progress="{Binding ImportFraction}" />
                    </VerticalStackLayout>
                </Border>

                <!--  ======== Alignment ========  -->

                <Border IsVisible="{Binding IsPaired}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">

                        <!--  The heading, and the way to find out what any of it means.  -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Style="{StaticResource Section}"
                                Text="{x:Static s:Strings.Details_AlignmentSection}"
                                VerticalOptions="Center" />

                            <Button
                                Grid.Column="1"
                                Clicked="OnAlignmentHelp"
                                Style="{StaticResource Icon}"
                                Text="?" />
                        </Grid>

                        <!--
                            Two ways to the same thing, so they are a choice rather than two
                            settings — but each one boxed on its own.

                            They used to be two bare rows sharing one paragraph underneath, which
                            left that paragraph belonging to neither: it described the first option
                            while sitting under the second, and the alignment summary hung below
                            both, describing something else again. Each option now carries its own
                            line, inside its own outline, and the summary sits under the option it
                            is actually about.
                        -->
                        <Border Style="{StaticResource Choice}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        Text="{x:Static s:Strings.Details_LiveAlignment}" />
                                    <Label
                                        Style="{StaticResource Muted}"
                                        Text="{x:Static s:Strings.Details_LiveAlignmentNote}" />
                                </VerticalStackLayout>

                                <Switch
                                    Grid.Column="1"
                                    IsToggled="{Binding MeasuresWhileReading}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Choice}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label
                                            FontFamily="OpenSansSemibold"
                                            Text="{x:Static s:Strings.Details_AlignAhead}" />
                                        <Label
                                            Style="{StaticResource Muted}"
                                            Text="{x:Static s:Strings.Details_AlignAheadNote}" />
                                    </VerticalStackLayout>

                                    <Switch
                                        Grid.Column="1"
                                        IsToggled="{Binding AlignsInAdvance}"
                                        VerticalOptions="Center" />
                                </Grid>

                                <!--  Where this book has got to, under the option it describes.  -->
                                <Label Style="{StaticResource Muted}" Text="{Binding AlignmentSummary}" />
                            </VerticalStackLayout>
                        </Border>

                        <!--  What is happening right now, when something is.  -->
                        <VerticalStackLayout IsVisible="{Binding IsAligning}" Spacing="10">
                            <HorizontalStackLayout Spacing="10">
                                <ActivityIndicator
                                    HeightRequest="16"
                                    IsRunning="{Binding IsAligning}"
                                    VerticalOptions="Center"
                                    WidthRequest="16" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding AlignmentMessage}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!--
                                The book, then the chapter. The second is the one that visibly
                                moves, so it is drawn quieter — two bars in the same colour moving
                                at different speeds read as two unrelated jobs.
                            -->
                            <ProgressBar Progress="{Binding AlignmentFraction}" />

                            <ProgressBar
                                Progress="{Binding ChapterFraction}"
                                ProgressColor="{AppThemeBinding Light={StaticResource InkMuted},
                                                                Dark={StaticResource InkMutedDark}}" />
                        </VerticalStackLayout>

                        <Label
                            IsVisible="{Binding IsIdleWithMessage}"
                            Style="{StaticResource Muted}"
                            Text="{Binding AlignmentMessage}" />

                        <Button
                            Command="{Binding StartAlignmentCommand}"
                            IsVisible="{Binding CanStartAlignment}"
                            Style="{StaticResource Primary}"
                            Text="{Binding StartAlignmentText}" />

                        <Button
                            Command="{Binding StopAlignmentCommand}"
                            IsVisible="{Binding IsAligning}"
                            Style="{StaticResource Secondary}"
                            Text="{x:Static s:Strings.Details_StopAlignment}" />

                        <!--
                            Deleting is its own button, next to the one that aligns.

                            It used to clear and start again in one press, which left no way to
                            simply be rid of an alignment: the only route to an empty map was
                            another run. Two decisions, two buttons — and this one is destructive,
                            so it is styled as such rather than sitting quietly as a secondary.
                        -->
                        <Button
                            Command="{Binding ClearAlignmentCommand}"
                            IsVisible="{Binding CanClearAlignment}"
                            Style="{StaticResource Destructive}"
                            Text="{Binding ClearAlignmentText}" />
                    </VerticalStackLayout>
                </Border>

                <!--  ======== Files ========  -->

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">

                        <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Details_FilesSection}" />

                        <Button
                            Command="{Binding AddAudioCommand}"
                            IsVisible="{Binding HasNoAudio}"
                            Style="{StaticResource Secondary}"
                            Text="{x:Static s:Strings.Details_AddAudio}" />
                        <Button
                            Command="{Binding RemoveAudioCommand}"
                            IsVisible="{Binding CanRemoveAudio}"
                            Style="{StaticResource Secondary}"
                            Text="{x:Static s:Strings.Details_RemoveAudio}" />
                        <Button
                            Command="{Binding AddEbookCommand}"
                            IsVisible="{Binding HasNoText}"
                            Style="{StaticResource Secondary}"
                            Text="{x:Static s:Strings.Details_AddEbook}" />
                        <Button
                            Command="{Binding RemoveEbookCommand}"
                            IsVisible="{Binding CanRemoveText}"
                            Style="{StaticResource Secondary}"
                            Text="{x:Static s:Strings.Details_RemoveEbook}" />
                    </VerticalStackLayout>
                </Border>

                <!--  ======== Find a page from a photo, once there is text to search ========  -->

                <Border IsVisible="{Binding HasText}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">

                        <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.Details_PageFinderSection}" />

                        <Label Style="{StaticResource Muted}" Text="{x:Static s:Strings.Details_PageFinderBody}" />

                        <Button
                            Command="{Binding LocatePageCommand}"
                            IsEnabled="{Binding CanLocatePage}"
                            Style="{StaticResource Secondary}"
                            Text="{x:Static s:Strings.Details_LocatePage}" />

                        <HorizontalStackLayout IsVisible="{Binding IsLocatingPage}" Spacing="10">
                            <ActivityIndicator
                                HeightRequest="16"
                                IsRunning="{Binding IsLocatingPage}"
                                VerticalOptions="Center"
                                WidthRequest="16" />
                            <Label
                                FontSize="13"
                                Text="{x:Static s:Strings.Details_LocatePageWorking}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label
                            IsVisible="{Binding HasPageLocatorNote}"
                            Style="{StaticResource Muted}"
                            Text="{Binding PageLocatorNote}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Apart from everything else, because it is not like anything else here.  -->
                <Button
                    Command="{Binding DeleteBookCommand}"
                    Margin="0,6,0,0"
                    Style="{StaticResource Destructive}"
                    Text="{x:Static s:Strings.Details_DeleteBook}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
