<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ReaderViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PaperBackground},
                                      Dark={StaticResource PaperBackgroundDark}}"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}">

    <!--
        The page is the text. Controls appear on a tap and go away again when the narration starts,
        because at that point the book is being read rather than operated.

        Two books meet here. One has only text, and then this is a plain reader: no transport, no
        alignment, nothing about a narrator. One has both, and then the same bar grows a play
        control — the same filled circle the player screen uses, at a size that suits a bar rather
        than a screen. The controls that only make sense with a voice are bound to HasAudio and
        simply are not there otherwise.
    -->

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Says why the text is not following, instead of leaving a dead control to explain itself.  -->
        <Label
            Grid.Row="0"
            Padding="16,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                              Dark={StaticResource ChromeDark}}"
            IsVisible="{Binding ShowFollowHint}"
            Style="{StaticResource Muted}"
            Text="{Binding FollowHint}" />

        <!--  A map covers only the chapters a run has reached; say so instead of standing still.  -->
        <Label
            Grid.Row="0"
            Padding="16,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                              Dark={StaticResource ChromeDark}}"
            IsVisible="{Binding HasFollowStatus}"
            Style="{StaticResource Muted}"
            Text="{Binding FollowStatus}" />

        <ActivityIndicator
            Grid.Row="1"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />

        <WebView
            x:Name="Reader"
            Grid.Row="1"
            Navigated="OnReaderNavigated"
            Navigating="OnReaderNavigating" />

        <!--  Controls  -->
        <VerticalStackLayout
            Grid.Row="2"
            BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                              Dark={StaticResource ChromeDark}}"
            IsVisible="{Binding ChromeVisible}"
            Padding="10,6"
            Spacing="2">

            <!--  Where you are, and the way out of the book in both directions.  -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button
                    Grid.Column="0"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource Icon}"
                    Text="✕" />

                <!--  Only when there is a narration to leave the text for.  -->
                <Button
                    Grid.Column="1"
                    Command="{Binding OpenPlayerCommand}"
                    IsVisible="{Binding HasAudio}"
                    Style="{StaticResource Icon}"
                    Text="🎧" />

                <!--  Was a downward swipe; that gesture now belongs to scrolling the text.  -->
                <Button
                    Grid.Column="2"
                    Command="{Binding JumpToChapterCommand}"
                    IsEnabled="{Binding HasChapters}"
                    Style="{StaticResource IconWide}"
                    Text="Poglavlja" />

                <Button
                    Grid.Column="3"
                    Command="{Binding ChooseThemeCommand}"
                    Style="{StaticResource IconWide}"
                    Text="{Binding ThemeName}" />

                <Button
                    Grid.Column="4"
                    Command="{Binding OpenDetailsCommand}"
                    Style="{StaticResource Icon}"
                    Text="☰" />
            </Grid>

            <!--
                Transport, identical in kind to the player's: skip back, the one filled control in
                the app, skip forward. It used to be a small transparent "⏸" wedged between two
                words, which is why pause here looked like it belonged to another program.
            -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding HasAudio}"
                Spacing="20">
                <Button
                    Command="{Binding BackCommand}"
                    Style="{StaticResource Skip}"
                    Text="↺10" />

                <Button
                    Command="{Binding TogglePlayCommand}"
                    Style="{StaticResource PlaySmall}"
                    Text="{Binding PlayLabel}" />

                <Button
                    Command="{Binding ForwardCommand}"
                    Style="{StaticResource Skip}"
                    Text="↻10" />
            </HorizontalStackLayout>

            <!--  Nudges the highlight against the voice; only meaningful while following.  -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                IsVisible="{Binding CanFollow}"
                Spacing="8">
                <Button
                    Command="{Binding NudgeSyncEarlierCommand}"
                    Style="{StaticResource IconWide}"
                    Text="◀ ranije" />
                <Label
                    Style="{StaticResource Muted}"
                    Text="{Binding SyncOffsetText}"
                    VerticalOptions="Center" />
                <Button
                    Command="{Binding NudgeSyncLaterCommand}"
                    Style="{StaticResource IconWide}"
                    Text="kasnije ▶" />
            </HorizontalStackLayout>

            <Slider
                x:Name="PageSlider"
                DragCompleted="OnPageSliderChanged"
                IsVisible="{Binding ShowPageSlider}"
                Maximum="{Binding PageCount}"
                Minimum="1"
                Value="{Binding PageNumber, Mode=OneWay}" />

            <!--  Font is here rather than in the bar above: it belongs with the page, not the book.  -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button
                    Grid.Column="0"
                    Command="{Binding ChooseFontCommand}"
                    Style="{StaticResource IconWide}"
                    Text="{Binding FontName}" />

                <Label
                    Grid.Column="1"
                    Padding="0,4"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource Muted}"
                    Text="{Binding DocumentLabel}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePageSliderCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
