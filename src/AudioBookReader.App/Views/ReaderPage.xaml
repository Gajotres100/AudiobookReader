<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ReaderViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PaperBackground},
                                      Dark={StaticResource PaperBackgroundDark}}"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}">

    <!--
        The page is the text. Controls appear on a tap and go away again when the narration starts,
        because at that point the book is being read rather than operated.

        Everything is one bar, at the top, and it is the same bar for a book with a narration and a
        book without one — only the play control comes and goes. At the bottom there is nothing to
        press: just where you are in the book, and a slider that appears if you tap it.
    -->

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--  Controls  -->
        <Grid
            Grid.Row="0"
            Padding="6,4"
            BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                              Dark={StaticResource ChromeDark}}"
            ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
            IsVisible="{Binding ChromeVisible}">

            <Button
                Grid.Column="0"
                Command="{Binding CloseCommand}"
                Style="{StaticResource Icon}"
                Text="✕" />

            <!--
                The one filled control in the app, and the same object the player uses. Only a book
                with a narration has it; a book with only text has nothing to play.
            -->
            <Button
                Grid.Column="1"
                Command="{Binding TogglePlayCommand}"
                IsEnabled="{Binding CanPlay}"
                IsVisible="{Binding HasAudio}"
                Style="{StaticResource PlayInline}"
                Text="{Binding PlayLabel}" />

            <!--  Was a downward swipe; that gesture now belongs to scrolling the text.  -->
            <Button
                Grid.Column="2"
                Command="{Binding JumpToChapterCommand}"
                IsEnabled="{Binding HasChapters}"
                Style="{StaticResource IconWide}"
                Text="Poglavlja" />

            <Button
                Grid.Column="3"
                Command="{Binding ChooseThemeCommand}"
                Style="{StaticResource IconWide}"
                Text="{Binding ThemeName}" />

            <!--  Only when there is a narration to leave the text for.  -->
            <Button
                Grid.Column="4"
                Command="{Binding OpenPlayerCommand}"
                IsVisible="{Binding HasAudio}"
                Style="{StaticResource Icon}"
                Text="🎧" />

            <Button
                Grid.Column="5"
                Command="{Binding OpenDetailsCommand}"
                Style="{StaticResource Icon}"
                Text="☰" />
        </Grid>

        <!--
            Says why the text is not following, instead of leaving a dead control to explain itself.
            Under the bar rather than over the text, so it never covers the line being read.
        -->
        <Label
            Grid.Row="1"
            Padding="16,8"
            BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                              Dark={StaticResource ChromeDark}}"
            IsVisible="{Binding ShowFollowHint}"
            Style="{StaticResource Muted}"
            Text="{Binding FollowHint}" />

        <!--  A map covers only the chapters a run has reached; say so instead of standing still.  -->
        <Label
            Grid.Row="1"
            Padding="16,8"
            BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                              Dark={StaticResource ChromeDark}}"
            IsVisible="{Binding HasFollowStatus}"
            Style="{StaticResource Muted}"
            Text="{Binding FollowStatus}" />

        <ActivityIndicator
            Grid.Row="2"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center" />

        <WebView
            x:Name="Reader"
            Grid.Row="2"
            Navigated="OnReaderNavigated"
            Navigating="OnReaderNavigating" />

        <!--  Where you are. Not a control, so it stays out of the bar and off the top.  -->
        <VerticalStackLayout
            Grid.Row="3"
            BackgroundColor="{AppThemeBinding Light={StaticResource Chrome},
                                              Dark={StaticResource ChromeDark}}"
            IsVisible="{Binding ChromeVisible}"
            Padding="10,2">

            <Slider
                x:Name="PageSlider"
                DragCompleted="OnPageSliderChanged"
                IsVisible="{Binding ShowPageSlider}"
                Maximum="{Binding PageCount}"
                Minimum="1"
                Value="{Binding PageNumber, Mode=OneWay}" />

            <Label
                Padding="0,4"
                HorizontalTextAlignment="Center"
                Style="{StaticResource Muted}"
                Text="{Binding DocumentLabel}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePageSliderCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
