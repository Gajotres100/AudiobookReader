<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:LibraryViewModel"
    Shell.NavBarIsVisible="False"
    Title="{x:Static s:Strings.Library_Title}">

    <!--
        The shelf. The first screen anyone sees, so it is the one that decides what the app is.

        A row per book with its cover, because a cover is how anyone finds a book they own — and a
        line of progress under the ones already started, since the question the shelf answers most
        often is "where was I". Nothing is filled or coloured except that line: on a screen of a
        dozen books, colour spent on chrome is colour taken from the covers.
    -->

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!--  ======== Title, and the three ways a book gets here ========  -->

        <Grid
            Grid.Row="0"
            Padding="20,16,12,8"
            ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">

            <Label
                Grid.Column="0"
                Style="{StaticResource Display}"
                Text="{x:Static s:Strings.Library_Title}"
                VerticalOptions="Center" />

            <!--
                A book that arrives whole: text, narration and alignment in one EPUB 3. Drawn unlike
                the plain icons beside it, because it is unlike them — it is not half of a book.
            -->
            <Button
                Grid.Column="1"
                Margin="0,0,6,0"
                Padding="10,0"
                BorderWidth="0"
                Command="{Binding ImportReadAlongCommand}"
                CornerRadius="15"
                FontFamily="OpenSansSemibold"
                FontSize="13"
                HeightRequest="30"
                SemanticProperties.Description="{x:Static s:Strings.Library_ImportReadAlong}"
                Text="EP3"
                TextColor="#FFFDF8"
                ToolTipProperties.Text="{x:Static s:Strings.Library_ImportReadAlong}"
                VerticalOptions="Center">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#F2B84B" />
                        <GradientStop Offset="0.55" Color="#D0801A" />
                        <GradientStop Offset="1" Color="#8E4F00" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Shadow>
                    <Shadow Brush="#B26A00" Opacity="0.45" Radius="8" Offset="0,2" />
                </Button.Shadow>
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding ImportAudioCommand}"
                Style="{StaticResource Icon}"
                Text="🎧" />

            <Button
                Grid.Column="3"
                Command="{Binding ImportEbookCommand}"
                Style="{StaticResource Icon}"
                Text="📖" />

            <Button
                Grid.Column="4"
                Command="{Binding OpenServerCommand}"
                Style="{StaticResource Icon}"
                Text="☁" />

            <!--
                Not a real purchase — the app is free and always will be. This exists because a $
                icon next to three real import actions is a joke worth having, not because there is
                anything behind it to buy.
            -->
            <Button
                Grid.Column="5"
                Command="{Binding PremiumCommand}"
                Style="{StaticResource Icon}"
                Text="$" />
        </Grid>

        <!--  Importing a whole audiobook takes time; without a number it reads as a hang.  -->
        <Border
            Grid.Row="1"
            IsVisible="{Binding IsBusy}"
            Margin="16,4"
            Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="12">
                    <ActivityIndicator
                        HeightRequest="18"
                        IsRunning="{Binding IsBusy}"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        Text="{Binding BusyMessage}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <ProgressBar IsVisible="{Binding HasBusyFraction}" Progress="{Binding BusyFraction}" />
            </VerticalStackLayout>
        </Border>

        <Label
            Grid.Row="2"
            IsVisible="{Binding HasError}"
            Margin="20,8"
            Style="{StaticResource Failure}"
            Text="{Binding Error}" />

        <!--  ======== An empty shelf, which is a first impression too ========  -->

        <VerticalStackLayout
            Grid.Row="3"
            IsVisible="{Binding IsEmpty}"
            Padding="36"
            Spacing="14"
            VerticalOptions="Center">

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Heading}"
                Text="{x:Static s:Strings.Library_EmptyTitle}" />

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Muted}"
                Text="{x:Static s:Strings.Library_EmptyBody}" />

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Muted}"
                Text="{x:Static s:Strings.Library_EmptyServer}" />
        </VerticalStackLayout>

        <!--  ======== The books ========  -->

        <CollectionView
            x:Name="BookList"
            Grid.Row="3"
            ItemSizingStrategy="MeasureFirstItem"
            ItemsSource="{Binding Books}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:BookCard">
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Alarm},
                                                                      Dark={StaticResource AlarmDark}}"
                                    Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference BookList}}"
                                    CommandParameter="{Binding .}"
                                    Text="{x:Static s:Strings.Common_Delete}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Grid
                            Padding="20,10"
                            ColumnDefinitions="58,*,Auto"
                            ColumnSpacing="14"
                            HeightRequest="92">

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Path=BindingContext.OpenCommand, Source={x:Reference BookList}}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>

                            <!--
                                The cover keeps its place whether or not there is one to show, so a
                                shelf of books with and without covers still reads as a column.
                            -->
                            <Border
                                Grid.Column="0"
                                HeightRequest="76"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="0"
                                VerticalOptions="Center"
                                WidthRequest="58">
                                <Image Source="{Binding CoverPath}" Style="{StaticResource Cover}" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="3"
                                VerticalOptions="Center">

                                <Label
                                    FontFamily="OpenSansSemibold"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Title}" />

                                <Label
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Author}" />

                                <Label
                                    FontSize="12"
                                    LineBreakMode="TailTruncation"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Subtitle}" />

                                <!--
                                    Where you got to. The only coloured thing on the row, because it
                                    is the only question the shelf is usually being asked.
                                -->
                                <ProgressBar
                                    HeightRequest="3"
                                    IsVisible="{Binding HasProgress}"
                                    Margin="0,3,0,0"
                                    Progress="{Binding Progress}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                FontSize="15"
                                Text="{Binding MediaBadge}"
                                VerticalOptions="Center" />
                        </Grid>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
