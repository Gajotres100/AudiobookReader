<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AudioBookReader.App.Views.ServerBookPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="clr-namespace:AudioBookReader.App.Resources.Strings"
    xmlns:vm="clr-namespace:AudioBookReader.App.ViewModels"
    x:DataType="vm:ServerBookViewModel"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}">

    <!--
        One book on the server, before deciding to bring it here.

        A page rather than a tap that starts a download. What is about to come over a phone's
        connection is worth seeing first — how long it is, whether it has the text as well as the
        voice, and whether the server keeps it in one file or forty, which is the thing that decides
        whether it can come at all.
    -->

    <Grid RowDefinitions="Auto,*,Auto" Padding="16,10">

        <Button
            Grid.Row="0"
            Command="{Binding CloseCommand}"
            HorizontalOptions="Start"
            Style="{StaticResource Icon}"
            Text="✕" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14">

                <Border
                    HeightRequest="260"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    WidthRequest="180">
                    <Image Source="{Binding CoverUrl}" Style="{StaticResource Cover}" />
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Heading}"
                        Text="{Binding Title}" />

                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Muted}"
                        Text="{Binding Author}" />

                    <Label
                        HorizontalTextAlignment="Center"
                        IsVisible="{Binding HasSeries}"
                        Style="{StaticResource Muted}"
                        Text="{Binding Series}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Style="{StaticResource Section}" Text="{x:Static s:Strings.ServerBook_OnServer}" />
                        <Label Text="{Binding Contents}" />
                        <Label Style="{StaticResource Muted}" Text="{Binding Length}" />
                        <Label Style="{StaticResource Muted}" Text="{Binding Chapters}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Why it cannot come, when it cannot — said here, not by a button that refuses.  -->
                <Label
                    IsVisible="{Binding CannotDownload}"
                    Text="{Binding Obstacle}"
                    Style="{StaticResource Failure}" />

                <!--  What is already here, which is what makes the button below make sense.  -->
                <Label
                    IsVisible="{Binding HasNote}"
                    Text="{Binding Note}"
                    Style="{StaticResource Muted}" />

                <!--
                    Nothing about where it goes. That question is asked once, by Preuzmi, and asking
                    it here as well made the same decision available in two places with no way to
                    tell which one had won.
                -->
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">

            <ProgressBar IsVisible="{Binding IsDownloading}" Progress="{Binding Progress}" />

            <!--
                The message on the left, the figure on the right. A bar answers whether anything is
                happening; on a book that takes twenty minutes over a phone connection the question
                is how much longer, and only a number answers that.
            -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasStatus}">

                <HorizontalStackLayout Grid.Column="0" Spacing="10">
                    <ActivityIndicator
                        HeightRequest="14"
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        VerticalOptions="Center"
                        WidthRequest="14" />

                    <Label
                        LineBreakMode="TailTruncation"
                        Style="{StaticResource Muted}"
                        Text="{Binding Status}"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label
                    Grid.Column="1"
                    FontFamily="OpenSansSemibold"
                    IsVisible="{Binding HasPercent}"
                    Text="{Binding Percent}"
                    VerticalOptions="Center" />
            </Grid>

            <Button
                Command="{Binding DownloadCommand}"
                IsEnabled="{Binding CanDownload}"
                IsVisible="{Binding IsIdle}"
                Style="{StaticResource Primary}"
                Text="{Binding DownloadText}" />

            <!--
                Playing from the server instead of downloading, for a device short of space or a
                book listened to once. The text still comes down; the audio stays where it is.
            -->
            <Button
                Command="{Binding StreamCommand}"
                IsVisible="{Binding ShowsStream}"
                Style="{StaticResource Secondary}"
                Text="{x:Static s:Strings.ServerBook_Stream}" />

            <!--
                Offered only when both halves are missing, because only then is there a choice:
                the audio is a gigabyte over whatever connection is to hand and the text is a
                rounding error beside it, and someone about to read on a train cares which arrives
                first. With one half already here, the button above names the other and that is all
                there is to say.
            -->
            <Button
                Command="{Binding DownloadAudioOnlyCommand}"
                IsVisible="{Binding ShowsHalfChoice}"
                Style="{StaticResource Secondary}"
                Text="{x:Static s:Strings.ServerBook_JustAudio}" />

            <Button
                Command="{Binding DownloadEbookOnlyCommand}"
                IsVisible="{Binding ShowsHalfChoice}"
                Style="{StaticResource Secondary}"
                Text="{x:Static s:Strings.ServerBook_JustEbook}" />

            <Button
                Command="{Binding CancelCommand}"
                IsVisible="{Binding IsDownloading}"
                Style="{StaticResource Secondary}"
                Text="{x:Static s:Strings.ServerBook_CancelDownload}" />

            <Button
                Command="{Binding OpenCommand}"
                IsVisible="{Binding IsInLibrary}"
                Style="{StaticResource Secondary}"
                Text="{x:Static s:Strings.ServerBook_OpenBook}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
