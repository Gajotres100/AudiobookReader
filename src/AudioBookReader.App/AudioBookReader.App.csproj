<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- iOS builds only on a Mac (Codemagic CI, since there is none locally), and Whisper.net.Runtime
		     ships ios-device/ios-simulator binaries already, so this is a target addition, not a rewrite. -->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>AudioBookReader.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- English base name. The Android launcher label overrides this per phone locale via
		     Platforms/Android/Resources/values{-hr}/strings.xml, since Croatian and English
		     deliberately carry different names (Čitko / Syncbook) rather than one translated
		     the other way. -->
		<ApplicationTitle>Syncbook</ApplicationTitle>
		<ApplicationId>com.gajotres.audiobookreader</ApplicationId>

		<ApplicationDisplayVersion>0.5</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

		<!-- Android 10. The thermal-status API that drives CPU backoff arrives in 29, so this floor
		     removes a pile of version guards for devices that are long gone anyway. -->
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-android'">29.0</SupportedOSPlatformVersion>

		<!-- iOS 18.5, set by Whisper.net.Runtime rather than by anything this app calls. Its iOS static
		     libraries are built with a minimum of 18.5, and libggml-blas references Accelerate's
		     cblas_sgemm$NEWLAPACK$ILP64, which only exists from iOS 16.4 — linked statically, so a
		     device below that fails at launch, before a line of this app runs. That is exactly what an
		     iPad on 16.3.1 did: opened and closed at once, with a declared floor of 15 promising it
		     would work. Declaring the real floor makes iOS refuse the install with a reason instead. -->
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-ios'">18.5</SupportedOSPlatformVersion>

		<!-- Whisper.net.Runtime ships android-arm64-v8a, android-x86_64 and android-x86 only, with
		     no armeabi-v7a. Naming the architectures explicitly keeps the build from producing a
		     package whose native libraries are missing, which would otherwise only surface at
		     runtime. Google Play requires 64-bit regardless; android-x64 is here for the emulator.

		     These are the exact strings Whisper.net.Runtime.targets tests against to decide which
		     .so files to pack, so they are not interchangeable with the older AndroidSupportedAbis
		     spelling — which this SDK has dropped anyway. -->
		<RuntimeIdentifiers Condition="'$(TargetFramework)'=='net10.0-android'">android-arm64;android-x64</RuntimeIdentifiers>

		<!-- Same reasoning as the Android RuntimeIdentifiers above, for Whisper.net.Runtime's
		     ios-device/ios-simulator native binaries. iossimulator carries the arm64 Apple Silicon
		     simulator slice; ios-arm64 is the only real-device architecture Apple ships today.

		     Only ios-arm64 by default, deliberately — not both. Xamarin.Shared.Sdk.targets checks
		     this literal property for more than one value and refuses to build at all if it finds
		     one ("Building for all the runtime identifiers ... isn't possible"), regardless of
		     whether a single RuntimeIdentifier has separately been resolved; a conditional default
		     for the singular property (tried first) did not help, since that check runs against
		     RuntimeIdentifiers before such a default is evaluated. -r on the command line (used
		     throughout codemagic.yaml, and by every local compile-check in this repo's history)
		     still overrides this cleanly to build for the simulator instead when asked — this
		     default only matters to Visual Studio's own device-target picker, which was found, on
		     this project, not to pass an override either, hitting the same error when it built for
		     "Remote Device". Defaulting to the real device RID rather than the simulator one because
		     Windows cannot run the iOS Simulator at all (no Mac) — a device is the only target this
		     default is ever actually used for. -->
		<RuntimeIdentifiers Condition="'$(TargetFramework)'=='net10.0-ios'">ios-arm64</RuntimeIdentifiers>


		<!-- The Media3 bindings declare tight upper bounds on AndroidX Lifecycle (< 2.9.3) while
		     MAUI brings 2.11. Google ships these libraries as one coordinated release and 2.11 is
		     compatible with 2.9 consumers, so the constraint is the binding's packaging being
		     conservative rather than a real conflict — and there is no version satisfying both.
		     Silenced because two dozen repeats of it on every build would bury warnings that do
		     matter. -->
		<NoWarn>$(NoWarn);NU1608</NoWarn>
	</PropertyGroup>

	<!-- Without an explicit -p:Platform, the SDK defaults PlatformTarget to this machine's own
	     architecture (x64, on an ordinary Windows PC), and its own _CheckForMismatchingPlatform
	     target then refuses to build because arm64 (the RuntimeIdentifier above) and x64 (that
	     default) don't match (NETSDK1032) — hit both from the command line with no RID override
	     and from Visual Studio's own iOS device/simulator pickers, neither of which passes one on
	     this project either. Irrelevant for iOS regardless: the RuntimeIdentifier alone already
	     says which architecture to build.

	     A plain PropertyGroup assignment does not survive to that check — some later step resets
	     PlatformTarget back to the machine default before _CheckForMismatchingPlatform runs, which
	     is exactly what defeated an earlier attempt at this same fix. That check's condition
	     exempts PlatformTarget only when it is the literal string "AnyCPU" (not merely empty), so
	     this target sets exactly that, timed via BeforeTargets to land immediately ahead of the
	     one check it needs to satisfy — the only ordering that is actually guaranteed regardless of
	     whatever else runs in between. -->
	<Target Name="_ClearIosPlatformTarget" BeforeTargets="_CheckForMismatchingPlatform"
	        Condition="'$(TargetFramework)'=='net10.0-ios'">
		<PropertyGroup>
			<PlatformTarget>AnyCPU</PlatformTarget>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#B26A00" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#B26A00" BaseSize="128,128" />

		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />

		<!-- Playback: ExoPlayer for the engine, Session for the foreground service, lock screen
		     controls and headset buttons. Android-only — iOS plays through AVFoundation directly,
		     which needs no NuGet package at all. -->
		<PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.10.1.1" Condition="'$(TargetFramework)'=='net10.0-android'" />
		<PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.10.1.2" Condition="'$(TargetFramework)'=='net10.0-android'" />

		<!-- On-device recognition for alignment. The model itself is downloaded at first use rather
		     than shipped, to keep the package small and satisfy Play's size expectations. -->
		<PackageReference Include="Whisper.net" Version="1.9.1" />
		<PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />

		<!-- The native SQLite the Core library's sqlite-net expects. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />

		<!-- Media3 and MAUI disagree about how new AndroidX should be, and NuGet resolves the
		     halves independently: core 1.19 with core-ktx 1.16, collection 1.6 with
		     collection-ktx 1.5. Recent AndroidX folded the -ktx artifacts into their base
		     libraries, so the mismatched pairs ship the same classes twice and dexing fails with
		     "Type ... is defined multiple times". Pinning each -ktx to its base library's version
		     is what keeps a single copy of each class in the package. -->
		<PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" Condition="'$(TargetFramework)'=='net10.0-android'" />
		<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" Condition="'$(TargetFramework)'=='net10.0-android'" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AudioBookReader.Core\AudioBookReader.Core.csproj" />
	</ItemGroup>

</Project>
